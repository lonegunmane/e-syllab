# ═══════════════════════════════════════════════════════════════════
# E-SYLLAB Backend — Render Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# Set these in the Render dashboard:
# Dashboard → your service → Environment → Add Environment Variable
#
# DO NOT commit actual values to GitHub. This file is a reference only.

# Required for the server to run
NODE_ENV=production
PORT=3000

# Required — your Vercel frontend URL (no trailing slash)
# This locks down CORS so only your frontend can call the API
ALLOWED_ORIGIN=https://e-syllab.vercel.app

# Required for offline blockchain sync to work
# Generate with: node generate-keypair.js
# Paste the full JSON array, e.g. [12,45,67,89,...]
SCHOOL_SIGNING_KEYPAIR=

# Optional — only needed if using the password reset email feature
# Get a free key at https://resend.com
RESEND_API_KEY=
